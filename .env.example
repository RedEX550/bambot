# ---------------------------------------------------------------------------
# Bambot configuration
# Copy to .env and fill in. Everything the bot, API and dashboard need is here.
# ---------------------------------------------------------------------------

# --- Discord application -----------------------------------------------------
# From https://discord.com/developers/applications -> your app
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
DISCORD_CLIENT_SECRET=your-oauth2-client-secret
# Optional: register commands instantly in one server while developing
DEV_GUILD_ID=

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://bambot:change-me@localhost:5432/bambot?schema=public

# --- API ---------------------------------------------------------------------
API_PORT=4000
# Must be a long random string. Generate with: openssl rand -hex 48
SESSION_SECRET=change-me-to-a-long-random-string
# Public URL the browser reaches the dashboard on
PUBLIC_URL=http://localhost:5173
# OAuth2 redirect. Must match the Discord developer portal exactly.
OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/callback
# Comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# --- Bot internal API --------------------------------------------------------
# The dashboard asks the bot to publish panels and preview messages over this.
BOT_INTERNAL_PORT=4100
BOT_INTERNAL_URL=http://localhost:4100
# Shared secret between API and bot. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=change-me-too

# --- Behaviour ---------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development
# Discord user IDs with full owner access to every dashboard guild
BOT_OWNER_IDS=
# Where HTML transcripts are written (also served by the API)
TRANSCRIPT_DIR=./data/transcripts
