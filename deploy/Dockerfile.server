# Shared image for the bot and the API — same dependencies, different entrypoint.
FROM node:22-bookworm-slim AS base
WORKDIR /app
ENV NODE_ENV=production

# openssl is required by Prisma; fonts are required by the welcome banner and
# rank card renderer, otherwise text falls back to boxes.
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates fonts-dejavu-core \
  && rm -rf /var/lib/apt/lists/*

FROM base AS build
ENV NODE_ENV=development
COPY package.json package-lock.json* ./
COPY packages/shared/package.json packages/shared/
COPY packages/bot/package.json packages/bot/
COPY packages/api/package.json packages/api/
COPY packages/web/package.json packages/web/
COPY prisma ./prisma
RUN npm ci --ignore-scripts

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY packages/bot packages/bot
COPY packages/api packages/api

RUN npx prisma generate \
  && npm run build -w @bambot/shared \
  && npm run build -w @bambot/bot \
  && npm run build -w @bambot/api

FROM base AS runtime
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/packages/bot/package.json ./packages/bot/package.json
COPY --from=build /app/packages/bot/dist ./packages/bot/dist
COPY --from=build /app/packages/api/package.json ./packages/api/package.json
COPY --from=build /app/packages/api/dist ./packages/api/dist

RUN mkdir -p /app/data && chown -R node:node /app/data
USER node

CMD ["node", "packages/bot/dist/index.js"]
